# ============================================================================
# LongFiction-AI Environment Configuration Example
# ============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM API Configuration (Required)
# ----------------------------------------------------------------------------
# Any OpenAI-compatible API endpoint works. Examples:
#   - OpenAI:     https://api.openai.com/v1
#   - DeepSeek:   https://api.deepseek.com/v1
#   - Qwen:       https://dashscope.aliyuncs.com/compatible-mode/v1
#   - Local LLM:  http://localhost:1234/v1 (LM Studio, Ollama, etc.)

OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# ----------------------------------------------------------------------------
# Model Selection (Required)
# ----------------------------------------------------------------------------
# Use LiteLLM model naming convention. Examples:
#   - OpenAI:    gpt-4o-mini, gpt-4o, gpt-4-turbo
#   - DeepSeek:  deepseek/deepseek-chat, deepseek/deepseek-coder
#   - Qwen:      openai/qwen-plus, openai/qwen-max
#   - Claude:    claude-3-5-sonnet-20241022
#   - Gemini:    gemini/gemini-pro

# Default model for unspecified tasks
LLM_DEFAULT_MODEL=gpt-4o-mini

# Task-specific models (can be the same or different)
LLM_PLANNER_MODEL=gpt-4o-mini   # Chapter planning, world-building, characters
LLM_WRITER_MODEL=gpt-4o-mini    # Main content generation
LLM_STYLE_MODEL=gpt-4o-mini     # Style rewriting, polishing
LLM_CHECK_MODEL=gpt-4o-mini     # Consistency checking, quality scoring

# ----------------------------------------------------------------------------
# LLM Behavior Settings
# ----------------------------------------------------------------------------
# Whether to request JSON response format (requires model support)
LLM_USE_RESPONSE_FORMAT=false

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=90

# Embedding model for FAISS vector search
EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------------
# Generation Settings
# ----------------------------------------------------------------------------
# Minimum word count per chapter (Chinese characters)
CHAPTER_MIN_WORDS=2000

# Target word count per scene
SCENE_TARGET_WORDS=800

# Number of versions to generate per chapter (1 = single version, 2+ = multi-version)
MULTI_VERSION_COUNT=1

# Fast test mode (skips enhancement layers for quicker generation)
FAST_TEST_MODE=false

# Skip AI de-tracing layer (faster but more AI-like output)
SKIP_DEEP_DEAI=false

# Skip quality scoring (faster but no quality feedback)
SKIP_QUALITY_SCORE=false

# Python path (used for module resolution)
PYTHONPATH=.

# ----------------------------------------------------------------------------
# Admin Account (Auto-created on first launch)
# ----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ----------------------------------------------------------------------------
# P0-3：JWT 独立密钥（重要！不要使用 LLM API Key）
# ----------------------------------------------------------------------------
# JWT 用于签发/校验用户登录 token，**不应**复用 LLM API Key：
# - 换 LLM Key 会触发全员登出（用户体验差）
# - 多实例部署时 LLM Key 不一致会导致跨实例 token 互认失败
# - 密钥职责混乱
#
# 生产环境必须显式设置至少 32 位的随机字符串。
# DEBUG=true 时若未设置，会使用固定开发密钥。
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars

# ----------------------------------------------------------------------------
# P0-2：LLM 调用稳定性配置
# ----------------------------------------------------------------------------
# Provider: openai | openai_compatible | newapi | oneapi | deepseek | qwen | lmstudio | ollama
LLM_PROVIDER=openai_compatible

# JSON mode 策略: auto | force | off
# - auto: 支持 JSON mode 的 provider 自动开，不支持自动降级
# - force: 强制 response_format（若模型不支持会失败）
# - off: 永远不开
LLM_JSON_MODE_POLICY=auto

# 单模型内部重试次数（不含首次）
LLM_MAX_RETRIES_PER_MODEL=2

# 主备模型切换：失败后自动选下一个模型
LLM_ROUTE_FALLBACK_ENABLED=true

# ----------------------------------------------------------------------------
# Email Service (Optional - for password reset and verification)
# ----------------------------------------------------------------------------
# Supported: QQ Mail (exmail.qq.com), Aliyun Mail, SendGrid, Resend
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USE_TLS=true

# ----------------------------------------------------------------------------
# Database (Optional - defaults to SQLite)
# ----------------------------------------------------------------------------
# SQLite (default): sqlite:///data/novel.db
# PostgreSQL:       postgresql://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///data/novel.db
